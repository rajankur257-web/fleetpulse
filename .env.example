# -----------------------------------------------------------------------------
# Fleet Pulse Environment Configuration Template
# Copy this file to .env before starting the services
# -----------------------------------------------------------------------------

# API Configuration (apps/api)
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://fleetpulse:fleetpulse_password@localhost:5432/fleetpulse?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="fleetpulse-dev-jwt-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="fleetpulse-dev-jwt-refresh-secret-minimum-32-chars-long"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Dispatch Engine Parameters
DISPATCH_STRATEGY="scored"
OFFER_TIMEOUT_SECONDS=20
MAX_OFFER_ATTEMPTS=3
BATCH_WINDOW_SECONDS=5
OSRM_URL="http://router.project-osrm.org"

# Dispatcher Web Dashboard (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Mobile Driver App (apps/mobile)
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
