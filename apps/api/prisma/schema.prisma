generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  admin
  dispatcher
  driver
}

enum DriverStatus {
  available
  busy
  offline
}

enum RequestStatus {
  pending
  offered
  assigned
  picked_up
  delivered
  cancelled
  expired
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(driver)
  driverId     String?  @unique
  driver       Driver?  @relation(fields: [driverId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Driver {
  id              String                                @id @default(uuid())
  name            String
  phone           String
  status          DriverStatus                          @default(offline)
  rating          Float                                 @default(5.0)
  lat             Float
  lng             Float
  location        Unsupported("geography(Point, 4326)")?
  lastLocationAt  DateTime?
  activeRequestId String?
  dailyTrips      Int                                   @default(0)
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt

  user             User?
  assignedRequests DeliveryRequest[]
  events           DispatchEvent[]

  @@index([location], type: Gist)
  @@index([status])
  @@index([createdAt])
}

model DeliveryRequest {
  id               String                                @id @default(uuid())
  pickupLat        Float
  pickupLng        Float
  dropLat          Float
  dropLng          Float
  pickupLocation   Unsupported("geography(Point, 4326)")?
  dropLocation     Unsupported("geography(Point, 4326)")?
  status           RequestStatus                         @default(pending)
  priority         Int                                   @default(1)
  assignedDriverId String?
  assignedDriver   Driver?                               @relation(fields: [assignedDriverId], references: [id])
  offeredAt        DateTime?
  assignedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt

  events DispatchEvent[]

  @@index([pickupLocation], type: Gist)
  @@index([dropLocation], type: Gist)
  @@index([status])
  @@index([createdAt])
  @@index([assignedDriverId])
}

model DispatchEvent {
  id        String           @id @default(uuid())
  requestId String?
  request   DeliveryRequest? @relation(fields: [requestId], references: [id])
  driverId  String?
  driver    Driver?          @relation(fields: [driverId], references: [id])
  type      String
  payload   Json
  createdAt DateTime         @default(now())

  @@index([requestId])
  @@index([driverId])
  @@index([type])
  @@index([createdAt])
}
